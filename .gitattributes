*.py diff=python

# Keep Unix line endings in everything that runs inside Linux (install
# scripts, Mininet itself, the Docker image, VMs), even when the repo is
# cloned on Windows with core.autocrlf=true
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
